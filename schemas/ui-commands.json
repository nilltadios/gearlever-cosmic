    "descriptions": [
      {
        "command": "instances",
        "description": "List running GUI instances; pass one with --instance when several run"
      },
      {
        "command": "inspect",
        "description": "State of the visible window: page, dialog, page content (view), text fields and controls with labels and required flags"
      },
      {
        "command": "controls",
        "description": "Only the controls that can be activated now"
      },
      {
        "command": "tree",
        "description": "Inspection plus rendered widgets with visible text and bounds"
      },
      {
        "command": "activate",
        "description": "Activate a control id from inspect (alias: click). Changes and starting other programs need --apply"
      },
      {
        "command": "navigate",
        "description": "Show apps, updates or add"
      },
      {
        "command": "open",
        "description": "Open package, repo or snapshot files for review; nothing is applied"
      },
      {
        "command": "drop",
        "description": "Send files through the drag-and-drop handler; nothing is applied"
      },
      {
        "command": "fill",
        "description": "Type into a text field listed under fields"
      },
      {
        "command": "theme",
        "description": "system, dark or light"
      },
      {
        "command": "window",
        "description": "Set --mode windowed|maximized|fullscreen or --width/--height"
      },
      {
        "command": "capture",
        "description": "Save the window's render to a new absolute PNG path"
      },
      {
        "command": "wait",
        "description": "Wait until loading, details and operations finish"
      },
      {
        "command": "start",
        "description": "Present the running GUI, or start an isolated one with --config-dir"
      },
      {
        "command": "activation-token",
        "description": "Request a Wayland activation token for launch tests"
      },
      {
        "command": "close",
        "description": "Close the selected window with --apply"
      },
      {
        "command": "schema",
        "description": "JSON Schema of GUI requests"
      }
