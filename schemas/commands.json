                  },
                  "repo_filename": {
                    "type": "string"
                  },
                  "repo_url": {
                    "type": "string"
                  }
                },
                "required": [
                  "manager",
                  "repo_url",
                  "repo_filename"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
