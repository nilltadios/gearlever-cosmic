                    "type": "boolean"
                  },
                  "manager": {
                    "const": "ForgejoUpdater",
                    "type": "string"
                  },
                  "repo_filename": {
                    "type": "string"
                  },
                  "repo_url": {
                    "type": "string"
                  }
                },
                "required": [
                  "manager",
                  "repo_url",
                  "repo_filename"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "description": "Anonymous FTP. url is ftp://HOST; filename a path pattern such as /pub/app/*/App-*.AppImage.",
                "properties": {
                  "filename": {
                    "type": "string"
                  },
                  "manager": {
