        ],
        "title": "SetSource",
        "type": "object"
      }
    },
    {
      "command": "settings.set",
      "description": "Change settings (only the given keys).",
      "dry_run_by_default": true,
      "example": {
        "settings": {
          "keep_replaced_versions_in_trash": true
        }
      },
      "mutates": true,
      "params_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "settings": {
            "additionalProperties": true,
            "description": "Only the settings to change; see settings.get for names and values.",
            "type": "object"
          }
        },
        "required": [
          "settings"
        ],
        "title": "SettingsSet",
        "type": "object"
      }
